# ---------------------------------------------------------------------------
# Inspiral configuration. Copy to .env and edit. NOTHING here is required to
# run the demo -- the mock host runtime is the default.
# ---------------------------------------------------------------------------

# Host runtime selection: "mock" (default) | "minds"
INSPIRAL_HOST=mock

# Path to the canon SQLite file.
INSPIRAL_DB=./data/canon.db

# Tick cadence in minutes (240 = every 4 hours).
INSPIRAL_TICK_MINUTES=240

# Max host invocations per 24h. The scheduler refuses to tick past this.
# Host invocations scale with narrative decisions, never with cast size or
# visitor traffic.
INSPIRAL_DAILY_HOST_BUDGET=12

# Deterministic mock seed -- same seed produces the same history.
INSPIRAL_SEED=1

# --- Only needed when INSPIRAL_HOST=minds -----------------------------------

# Builder API key from https://build.hellominds.ai/console
# The client lib reads this name via its BUILDER_API_KEY_ENV constant.
MINDS_BUILDER_API_KEY=

# The single Mind that projects all three faction leaders. If unset, the
# adapter calls listMinds() and uses the first Mind on the account.
INSPIRAL_MIND_ID=

# Conversation aliases. One Mind, several conversation lanes.
INSPIRAL_ALIAS_TICK=tick
INSPIRAL_ALIAS_ONBOARD=onboard
INSPIRAL_ALIAS_FAN_EVENTS=fan-events
INSPIRAL_ALIAS_QC=qc

# Reply timeout in ms for waitForReply.
INSPIRAL_HOST_TIMEOUT_MS=180000

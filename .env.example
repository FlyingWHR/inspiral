# ---------------------------------------------------------------------------
# Inspiral configuration. Copy to .env and edit. NOTHING here is required to
# run the demo -- the mock host runtime is the default.
# ---------------------------------------------------------------------------

# Host runtime selection: "mock" (default) | "minds"
INSPIRAL_HOST=mock

# Path to the canon SQLite file.
INSPIRAL_DB=./data/canon.db

# Tick cadence in minutes (240 = every 4 hours).
INSPIRAL_TICK_MINUTES=240

# Max host invocations per 24h. The scheduler refuses to tick past this.
# Host invocations scale with narrative decisions, never with cast size or
# visitor traffic.
INSPIRAL_DAILY_HOST_BUDGET=12

# Deterministic mock seed -- same seed produces the same history.
INSPIRAL_SEED=1

# --- Only needed when INSPIRAL_HOST=minds -----------------------------------

# Builder API key from https://build.hellominds.ai/console
# The client lib reads this name via its BUILDER_API_KEY_ENV constant.
MINDS_BUILDER_API_KEY=

# The single Mind that projects all three faction leaders. If unset, the
# adapter calls listMinds() and uses the first Mind on the account.
INSPIRAL_MIND_ID=

# Conversation aliases. One Mind, several conversation lanes.
INSPIRAL_ALIAS_TICK=tick
INSPIRAL_ALIAS_ONBOARD=onboard
INSPIRAL_ALIAS_FAN_EVENTS=fan-events
INSPIRAL_ALIAS_QC=qc

# Reply timeout in ms for waitForReply.
INSPIRAL_HOST_TIMEOUT_MS=180000

# --- IP pipeline ------------------------------------------------------------

# Where FixtureSource looks for fixture directories.
INSPIRAL_FIXTURES=./fixtures

# Base URL for the tracked links in outbound clip drafts.
INSPIRAL_CLIP_BASE=http://localhost:8790

# The owner's approval gate and daily digest. The TOKEN alone activates the
# Telegram channel; with no token the CLI gate is used instead. Nothing is ever
# posted to a public feed from here.
TELEGRAM_BOT_TOKEN=

# Optional. Leave blank and the chat is taken from whoever messaged the bot
# last, so you never have to look your own chat id up.
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# THE PIECES PRODUCT  (npm run pieces:serve)
# ---------------------------------------------------------------------------

# Opens the authenticated API. FAILS CLOSED: with this unset the server still
# starts and still serves the public piece pages, but every /v1 route answers
# 503. An open write endpoint on a log whose whole value is that it can be
# trusted would be worse than no endpoint at all.
INSPIRAL_API_KEY=

# Base for permalinks and the link inside a notification. Set this to whatever
# the server is actually reachable at, or every receipt you send points at
# localhost.
INSPIRAL_PUBLIC_URL=http://localhost:8795

# The conversation lane the narrate/route calls use. Its OWN lane, deliberately:
# a lane carries history the Mind pattern-matches, and asking for one line of
# prose in a lane full of JSON directives comes back as JSON.
INSPIRAL_ALIAS_PIECES=pieces

# ---------------------------------------------------------------------------
# NOTIFICATIONS
# ---------------------------------------------------------------------------
# `console` is always available and needs nothing. Each variable below adds one
# more channel. A person chooses a channel by name in their preferences, so
# these names are stored values -- renaming one silently stops delivery.

# Telegram. TELEGRAM_CHAT_ID is an optional fallback when a preference carries
# no address of its own.
# TELEGRAM_BOT_TOKEN=

# Default webhook target. A per-person address overrides it. The URL is
# SSRF-guarded: http(s) only, and private/link-local/loopback ranges refused.
# INSPIRAL_WEBHOOK_URL=
# Lift the private-range refusal. Only for a webhook you host yourself.
# INSPIRAL_WEBHOOK_ALLOW_PRIVATE=0

# Append every delivery to a JSONL file. Useful for seeing what went out
# without wiring a real channel.
# INSPIRAL_NOTIFY_FILE=./data/notifications.jsonl

# Per-request timeout for any channel that talks to a network. Default 10s.
# INSPIRAL_NOTIFY_TIMEOUT_MS=10000

# ---------------------------------------------------------------------------
# silent | warn | info | debug. Default info.
INSPIRAL_LOG=info

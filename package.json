{
  "name": "inspiral",
  "version": "0.1.0",
  "private": true,
  "description": "Inspiral - mints living inhabitants into any 3D world. Canon DB + directive spec + host runtime.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "tsx scripts/demo.ts",
    "demo:reset": "tsx scripts/demo.ts --reset",
    "tick": "tsx scripts/tick.ts",
    "canon": "tsx scripts/canon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

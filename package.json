{
  "name": "inspiral",
  "version": "0.1.0",
  "private": true,
  "description": "Inspiral - mints living inhabitants into any 3D world. Canon DB + directive spec + host runtime.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "demo": "node --env-file-if-exists=.env --import tsx scripts/demo.ts",
    "demo:reset": "node --env-file-if-exists=.env --import tsx scripts/demo.ts --reset",
    "world": "node --env-file-if-exists=.env --import tsx scripts/world.ts",
    "voxel": "node --env-file-if-exists=.env --import tsx scripts/voxel.ts",
    "clock": "node --env-file-if-exists=.env --import tsx scripts/clock.ts",
    "clock:status": "node --env-file-if-exists=.env --import tsx scripts/clock-status.ts",
    "chat": "node --env-file-if-exists=.env --import tsx scripts/chat.ts",
    "tick": "node --env-file-if-exists=.env --import tsx scripts/tick.ts",
    "canon": "node --env-file-if-exists=.env --import tsx scripts/canon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.0",
    "three": "^0.185.1",
    "ws": "^8.21.3",
    "zod": "^3.24.1"
  },
  "optionalDependencies": {
    "@animocabrands/minds-client-lib": "^0.1.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/three": "^0.185.4",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
